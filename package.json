{
  "name": "tyriongump-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "@swup/a11y-plugin": "^5.2.1",
    "@swup/head-plugin": "^2.3.1",
    "@swup/preload-plugin": "^3.2.12",
    "@swup/scroll-plugin": "^4.0.0",
    "swup": "^4.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.12",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.17.1"
}
