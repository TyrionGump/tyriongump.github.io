{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": ["import"],

  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },

  "ignorePatterns": ["dist", "public"],

  "rules": {
    "import/no-cycle": ["error", { "ignoreTypes": false }],
    "import/no-unassigned-import": "error"
  },

  "overrides": [
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.\\./)+(src/)?(content/|chrome/|pages/|site-pages)",
                "message": "lib/ is the floor: it knows nothing about this site."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/content/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.\\./)+(src/)?(lib|chrome|pages)/",
                "message": "content/ is data: it may not import code."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/chrome/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.\\./)+(src/)?pages/",
                "message": "chrome/ is on every page, so it may not depend on one."
              },
              {
                "regex": "(\\.\\./)+([^/.]+/)+mount-",
                "message": "mount-* are wired only in main.ts. render-* may be composed freely."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./[^./][^/]*/",
                "message": "A page may not import another page."
              },
              {
                "regex": "(\\.\\./)+([^/.]+/)+mount-",
                "message": "mount-* are wired only in main.ts. render-* may be composed freely."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["build/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.\\./)*src/(lib/motion|content|styles)/",
                "message": "build/ runs in Node with no DOM. It may import only lib/html-template and render-* modules."
              },
              {
                "regex": "(\\.\\./)*src/lib/dom-",
                "message": "build/ runs in Node with no DOM: the dom-* helpers need a live document."
              },
              {
                "regex": "(\\.\\./)*src/(chrome|pages)/[^/]+/mount-",
                "message": "build/ runs in Node with no DOM: mount-* modules touch the document."
              }
            ]
          }
        ]
      }
    }
  ]
}
