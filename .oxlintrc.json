{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": ["import"],

  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },

  "ignorePatterns": ["dist", "public"],

  "rules": {
    "import/no-cycle": ["error", { "ignoreTypes": false }],
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },

  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.\\./)+(src/)?(animation|routing|content|components)/",
                "message": "shared/ is the floor: it imports nothing outside itself. See docs/architecture.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/animation/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.\\./)+(src/)?(routing|content|components)/",
                "message": "animation/ must stay site-ignorant — no routes, copy or components. See docs/architecture.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/routing/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.\\./)+(src/)?(content|components)/",
                "message": "routing/ may not reach content/ or components/. See docs/architecture.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/content/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.\\./)+(src/)?components/",
                "message": "content/ is data: it may not import components. See docs/architecture.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.\\./)+[^/]+/mount-",
                "message": "Components never reach for each other's behaviour — mount-* are wired only in main.ts. render-* may be composed freely."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["build/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.\\./)*src/(animation|routing|content|styles)/",
                "message": "build/ runs in Node with no DOM. It may import only shared/html-template and the render-* named in the slot map."
              },
              {
                "regex": "(\\.\\./)*src/shared/dom-",
                "message": "build/ runs in Node with no DOM: dom-queries and dom-rendering need a live document."
              },
              {
                "regex": "(\\.\\./)*src/components/[^/]+/mount-",
                "message": "build/ runs in Node with no DOM — mount-* modules touch the document."
              }
            ]
          }
        ]
      }
    }
  ]
}
