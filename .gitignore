# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# Only used if pnpm's `store-dir` is pointed here.
.pnpm-store/

# ── Build output ──────────────────────────────────────────────────────────────
dist/

# Transient config copies that older Vite versions write here.
vite.config.ts.timestamp-*
vitest.config.ts.timestamp-*

# ── Tooling artefacts ─────────────────────────────────────────────────────────
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
pnpm-debug.log*
npm-debug.log*
yarn-error.log*

# ── Editors and OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Local agent tooling ───────────────────────────────────────────────────────
# launch.json holds a machine-specific node path.
.claude/worktrees/
.claude/launch.json

# ── Deliberately NOT ignored ──────────────────────────────────────────────────
# pnpm-lock.yaml: CI's `--frozen-lockfile` install fails without it.
# public/fonts/: the self-hosted fonts are source; nothing regenerates them.
